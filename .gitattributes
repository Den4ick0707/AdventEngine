# Normalize line endings: LF in the repository, native on checkout.
* text=auto

# Always LF (scripts and configs run on Linux CI)
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Always CRLF (Windows scripts)
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets are stored in Git LFS (run `git lfs install` once per machine).
*.glb  filter=lfs diff=lfs merge=lfs -text
*.bin  filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text

# glTF JSON is text: keep it diffable
*.gltf text

# vendor/ holds plain copies of third-party libraries (ADR 0005): never store them in LFS,
# so a clone works offline without git-lfs. "!" resets the LFS attributes set above.
vendor/** !filter !diff !merge linguist-vendored
