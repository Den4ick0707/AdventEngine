#!/usr/bin/env bash
# Commit message rules (see CONTRIBUTING.md):
#   - subject in English, imperative, starts with a capital letter: "Add swapchain recreation"
#   - or a vendor change: "vendor(glfw): Fix resize on X11"
#   - subject at most 72 characters, blank line before the body
set -euo pipefail

file="$1"
# Git runs this hook before stripping comments and leading blank lines, so do it here.
# Also stop at the scissors line that `git commit -v` adds.
mapfile -t lines < <(sed '/^# -\{24\} >8 -\{24\}$/,$d' "$file" | grep -v '^#' | sed '/./,$!d')
subject="${lines[0]:-}"
second="${lines[1]:-}"

# Generated by git itself.
if [[ "$subject" =~ ^(Merge|Revert|fixup!|squash!|amend!) ]]; then
    exit 0
fi

fail() {
    echo "commit-msg: $1" >&2
    echo "  subject: \"$subject\"" >&2
    echo "  rules:   CONTRIBUTING.md (skip once with git commit --no-verify)" >&2
    exit 1
}

[[ -n "$subject" ]] || fail "empty subject"
((${#subject} <= 72)) || fail "subject is longer than 72 characters (${#subject})"
[[ "$subject" =~ ^(vendor\([A-Za-z0-9_.-]+\):\ )?[A-Z] ]] || fail "subject must start with a capital letter (or vendor(<lib>): )"
[[ ! "$subject" =~ \.$ ]] || fail "no period at the end of the subject"
[[ -z "$second" ]] || fail "leave a blank line between the subject and the body"
