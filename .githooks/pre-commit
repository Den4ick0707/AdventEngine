#!/usr/bin/env bash
# Checks formatting of staged C++ files in engine/, apps/, tests/. Fix with: ./dev format
# Skip once with: git commit --no-verify
set -euo pipefail

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- \
    'engine/*.cpp' 'engine/*.hpp' 'apps/*.cpp' 'apps/*.hpp' 'tests/*.cpp' 'tests/*.hpp')
[[ ${#files[@]} -eq 0 ]] && exit 0

clang_format="${CLANG_FORMAT:-}"
if [[ -z "$clang_format" ]]; then
    for candidate in clang-format-18 clang-format; do
        command -v "$candidate" >/dev/null 2>&1 && clang_format="$candidate" && break
    done
fi
if [[ -z "$clang_format" ]]; then
    echo "pre-commit: clang-format not found, formatting not checked (./dev setup --install)" >&2
    exit 0
fi

if ! "$clang_format" --dry-run --Werror "${files[@]}" 2>/dev/null; then
    echo "pre-commit: some files are not formatted. Run ./dev format, then git add them again:" >&2
    "$clang_format" --dry-run "${files[@]}" 2>&1 | grep -oE '^[^:]+' | sort -u | sed 's/^/  /' >&2
    exit 1
fi
