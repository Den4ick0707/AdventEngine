#!/usr/bin/env bash
# 1. Blocks direct pushes to main and dev: they change only through Pull Requests (CONTRIBUTING.md).
#    GitHub rulesets enforce the same on the server; this hook just fails earlier.
#    Override once (e.g. the very first push of dev): ADVENT_ALLOW_PROTECTED_PUSH=1 git push ...
# 2. Uploads Git LFS objects (assets/), which git-lfs would normally do from its own pre-push hook.
set -euo pipefail

input="$(cat)"

if [[ "${ADVENT_ALLOW_PROTECTED_PUSH:-0}" != "1" ]]; then
    while read -r _local_ref _local_sha remote_ref _remote_sha; do
        case "$remote_ref" in
        refs/heads/main | refs/heads/dev)
            echo "pre-push: direct push to ${remote_ref#refs/heads/} is not allowed. Open a Pull Request." >&2
            echo "          (override once: ADVENT_ALLOW_PROTECTED_PUSH=1 git push ...)" >&2
            exit 1
            ;;
        esac
    done <<<"$input"
fi

if command -v git-lfs >/dev/null 2>&1; then
    git lfs pre-push "$@" <<<"$input"
fi
