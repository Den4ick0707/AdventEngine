{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (validation layers, asserts)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ADVENT_ENABLE_VALIDATION": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ADVENT_ENABLE_VALIDATION": "OFF"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "Release with debug info (profiling)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ADVENT_ENABLE_VALIDATION": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer/UBSan (Linux)",
      "inherits": "debug",
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "ci-debug",
      "displayName": "CI Debug (warnings as errors)",
      "inherits": "debug",
      "cacheVariables": { "ADVENT_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "ci-release",
      "displayName": "CI Release (warnings as errors)",
      "inherits": "release",
      "cacheVariables": { "ADVENT_WARNINGS_AS_ERRORS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ci-debug", "configurePreset": "ci-debug" },
    { "name": "ci-release", "configurePreset": "ci-release" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 60 }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "relwithdebinfo", "inherits": "base", "configurePreset": "relwithdebinfo" },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": { "ASAN_OPTIONS": "detect_leaks=1", "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1" }
    },
    { "name": "ci-debug", "inherits": "base", "configurePreset": "ci-debug" },
    { "name": "ci-release", "inherits": "base", "configurePreset": "ci-release" }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "ci-debug",
      "steps": [
        { "type": "configure", "name": "ci-debug" },
        { "type": "build", "name": "ci-debug" },
        { "type": "test", "name": "ci-debug" }
      ]
    },
    {
      "name": "ci-release",
      "steps": [
        { "type": "configure", "name": "ci-release" },
        { "type": "build", "name": "ci-release" },
        { "type": "test", "name": "ci-release" }
      ]
    }
  ]
}
