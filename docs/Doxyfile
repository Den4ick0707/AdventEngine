# Doxygen configuration for the AdventEngine documentation site.
# Run from the repository root: ./dev docs (output: build/docs/html).
# Only non-default settings are listed; see `doxygen -g` for the full reference.

PROJECT_NAME           = AdventEngine
PROJECT_NUMBER         = $(ADVENT_VERSION)
PROJECT_BRIEF          = "Модульний 3D-рушій на C++20 і Vulkan 1.3"
OUTPUT_DIRECTORY       = build/docs
# Generated labels in English: the Ukrainian translation of Doxygen is outdated since 1.8.4.
# The content itself (pages, comments) stays as written.
OUTPUT_LANGUAGE        = English
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    = engine/core/include \
                         engine/platform/include \
                         engine/renderer/include \
                         engine/runtime/include
FULL_PATH_NAMES        = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
BUILTIN_STL_SUPPORT    = NO

#---------------------------------------------------------------------------
# What to extract
#---------------------------------------------------------------------------
# Every class and member appears in the reference, documented or not, including private ones:
# the site is meant to explain how the program is built, and collaboration diagrams need
# private members to show ownership (e.g. Application owns Window and VulkanContext).
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
# Diagrams show only engine classes, not std, Vulkan or built-in types.
HIDE_UNDOC_RELATIONS   = YES
EXCLUDE_SYMBOLS        = advent::detail

#---------------------------------------------------------------------------
# Input: manual documentation (Markdown) and public headers
#---------------------------------------------------------------------------
INPUT                  = README.md \
                         docs/getting-started.md \
                         docs/development.md \
                         docs/architecture.md \
                         docs/roadmap.md \
                         docs/coding-style.md \
                         docs/threading.md \
                         CONTRIBUTING.md \
                         docs/adr/README.md \
                         docs/adr \
                         vendor/README.md \
                         CHANGELOG.md \
                         engine
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */src/*
INPUT_ENCODING         = UTF-8
FILTER_PATTERNS        = *.md=docs/tools/doxygen_md_filter.py

#---------------------------------------------------------------------------
# Preprocessor: document the Debug variant of macros
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
PREDEFINED             = ADVENT_ENABLE_ASSERTS \
                         ADVENT_VALIDATION_DEFAULT=1

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = $(ADVENT_DOXYGEN_WARN_AS_ERROR)
WARN_LOGFILE           = build/docs/warnings.log

#---------------------------------------------------------------------------
# HTML: doxygen-awesome-css theme, sidebar layout
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT
HTML_EXTRA_STYLESHEET  = vendor/doxygen-awesome-css/doxygen-awesome.css \
                         vendor/doxygen-awesome-css/doxygen-awesome-sidebar-only.css
SEARCHENGINE           = YES
SOURCE_BROWSER         = NO

#---------------------------------------------------------------------------
# Diagrams (Graphviz)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
UML_LOOK               = NO
TEMPLATE_RELATIONS     = YES
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 60
